# Application images.
UI_IMAGE=ghcr.io/typeitorg/boero-ui
UI_VERSION=sha-replace-with-ui-commit
API_IMAGE=ghcr.io/typeitorg/boero-api
API_VERSION=sha-replace-with-api-commit

# Local ports for Nginx and health checks.
UI_HOST_PORT=3000
API_HOST_PORT=8080

# Enable only when the environment uses HTTP.
AUTH_COOKIE_SECURE=true

# Resource limits.
UI_MEMORY_LIMIT=1024m
UI_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1024m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# PostgreSQL credentials.
DB_NAME=boero
DB_USER=boero
DB_PASSWORD=change-me

# Authentication and refresh-token keys.
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-for-hs256
REFRESH_REPLAY_ENCRYPTION_KEY=base64-encoded-32-byte-key
REFRESH_REPLAY_TTL=5s

# Passkey domain and HTTPS origin.
WEBAUTHN_RP_ID=replace-me.example.com
WEBAUTHN_ALLOWED_ORIGINS=https://replace-me.example.com

# Mail server.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com

# Canonical public origin and optional institutional subdomain routing.
# Leave INSTITUTIONAL_BASE_DOMAIN empty to preserve generic-only access.
FRONTEND_PUBLIC_URL=https://replace-me.example.com
INSTITUTIONAL_BASE_DOMAIN=
EMAIL_VERIFICATION_FRONTEND_URL=https://replace-me.example.com

# Password recovery.
PASSWORD_RECOVERY_FRONTEND_URL=https://replace-me.example.com
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# Optional initial administrator.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Log rotation.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# PostgreSQL backups.
BACKUP_DIR=/var/backups/boero
BACKUP_RETENTION_DAYS=7
# Persistent application file storage.
STORAGE_PROVIDER=local
# Create the S3 bucket before use; see docs/S3.md.
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=boero/
AWS_REGION=us-east-1
# Use an IAM role or API-specific credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Session token for temporary AWS credentials.
AWS_SESSION_TOKEN=
