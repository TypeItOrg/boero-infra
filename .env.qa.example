# Independent QA config: copy to .env.qa and replace every credential/image placeholder.
# Do not copy staging/production credentials, database names or storage configuration.
UI_IMAGE=ghcr.io/typeitorg/boero-ui
UI_VERSION=sha-replace-with-full-40-character-develop-ui-commit
API_IMAGE=ghcr.io/typeitorg/boero-api
API_VERSION=sha-replace-with-full-40-character-develop-api-commit
UI_HOST_PORT=3001
API_HOST_PORT=8081
MAILPIT_HOST_PORT=8026
AUTH_COOKIE_SECURE=true

UI_MEMORY_LIMIT=1024m
UI_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1024m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5
MAILPIT_MEMORY_LIMIT=128m

DB_NAME=boero_qa
DB_USER=boero_qa
DB_PASSWORD=replace-with-independent-qa-database-password
JWT_SECRET=replace-with-independent-qa-32-byte-or-longer-secret
REFRESH_REPLAY_ENCRYPTION_KEY=replace-with-independent-qa-base64-32-byte-key
REFRESH_REPLAY_TTL=5s

FRONTEND_PUBLIC_URL=https://testing.typeit.com.ar
INSTITUTIONAL_BASE_DOMAIN=testing.typeit.com.ar
WEBAUTHN_RP_ID=testing.typeit.com.ar
# Generic origin only. API adds the request-resolved active institutional origin; do not allowlist siblings.
WEBAUTHN_ALLOWED_ORIGINS=https://testing.typeit.com.ar
EMAIL_VERIFICATION_FRONTEND_URL=https://testing.typeit.com.ar
PASSWORD_RECOVERY_FRONTEND_URL=https://testing.typeit.com.ar
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# compose.qa.yaml forces capture-only Mailpit SMTP. Credentials are unused synthetic
# nonempty values for backward-compatible base Compose interpolation; never SMTP secrets.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=qa-unused
MAIL_PASSWORD=qa-unused
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@testing.typeit.com.ar

# Optional QA-only initial administrator; no institution/demo data is seeded implicitly.
PLATFORM_ADMIN_EMAIL=qa-admin@example.invalid
PLATFORM_ADMIN_PASSWORD=replace-with-independent-qa-administrator-password
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
BACKUP_DIR=/var/backups/boero
BACKUP_RETENTION_DAYS=7
STORAGE_PROVIDER=local
